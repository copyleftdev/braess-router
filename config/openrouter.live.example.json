{
  "bind": "127.0.0.1:8083",
  "mode": "live",
  "url": "https://openrouter.ai/api/v1/chat/completions",
  "journal_path": "/tmp/braess-openrouter-example.jsonl",
  "deadline_ms": 8000,
  "max_request_bytes": 16384,
  "max_response_bytes": 65536,
  "admission_limit": 1,
  "max_calls": 8,
  "routes": {
    "general": { "model": "openai/gpt-4.1-nano", "provider": "openai", "max_tokens": 128 },
    "coding": { "model": "openai/gpt-4.1-nano", "provider": "openai", "max_tokens": 128 },
    "reasoning": { "model": "openai/gpt-4.1-nano", "provider": "openai", "max_tokens": 128 }
  }
}
